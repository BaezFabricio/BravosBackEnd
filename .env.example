# Base de datos
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=""
DB_DATABASE=bravosdata
DB_PORT=3306

# Puerto del servidor
PORT=3001
BACKEND_URL=http://192.168.1.50:3001

# JWT
JWT_SECRET=your_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Node Environment
NODE_ENV=development

# 1 si el backend esta detras de ngrok, Caddy u otro proxy: usa la IP real de cada visitante (X-Forwarded-For) para limitar intentos.
# Sin esto, todos los visitantes cuentan como una sola IP y se bloquean entre si. Dejar vacio si se accede directo, sin proxy.
TRUST_PROXY=

SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-google

# URL pública del backend que se usará en los emails de verificación
# En producción: https://api.tu-dominio.com
# En desarrollo LAN: http://192.168.1.50:3001
BACKEND_URL=http://localhost:3001

# URL pública del frontend
# En producción: https://app.tu-dominio.com
# En desarrollo LAN: http://192.168.0.10:5174
FRONTEND_URL=http://localhost:5174
# Notificaciones push. Generar las claves una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La privada es secreta: nunca en git ni en el frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:correo-del-gimnasio@ejemplo.com

# Cloudinary (imágenes de la landing y avatares)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
