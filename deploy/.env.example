# Copiar a deploy/.env EN EL SERVIDOR (nunca a git) y completar. chmod 600 .env
DOMINIO=app.tu-dominio.com
DB_DATABASE=bravosdata
DB_ROOT_PASSWORD=poner-una-clave-larga-y-aleatoria

# Sesiones: al menos 32 caracteres aleatorios.  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Correo (contraseña de aplicación de Google)
SMTP_USER=
SMTP_PASS=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_POS_EXTERNAL_ID=

# Notificaciones push (las MISMAS claves que hoy: si se cambian, los celulares ya suscriptos dejan de recibir avisos)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:correo-del-gimnasio@ejemplo.com

# Imágenes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backups externos (rclone): nombre del destino configurado, ej. gdrive:bravos-backups
BACKUP_DESTINO=
